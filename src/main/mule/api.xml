<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="httpListenerAdminReprocessFlow"
		doc:id="f8087b3f-7d8c-42e0-8777-e9a996423fff">
		<http:listener doc:name="Listener"
			doc:id="1973020a-4bd0-431a-92ee-b78dee8f87b6"
			path="/api/admin/reprocess" allowedMethods="POST"
			config-ref="HTTP_Listener_config" />
		<flow-ref doc:name="adminReprocessSubflow"
			doc:id="a51022ea-78a8-4be6-afd5-9ca4ae9cb8de"
			name="adminReprocessSubflow" />
	</flow>
	<flow name="httpListenerPingFlow"
		doc:id="6793c35e-6c88-4b45-ba70-2e9e87cc8e08">
		<http:listener doc:name="Listener"
			doc:id="ba17db14-c200-4453-8a54-b22a4c041002"
			config-ref="HTTP_Listener_config" path="/api/ping"
			allowedMethods="GET" />
		<flow-ref doc:name="pingSubflow"
			doc:id="33176948-ba48-4b9c-ad7d-d5fbcc19b73a" name="pingSubflow" />
	</flow>
	<flow name="httpListenerUpdateWatermarkFlow"
		doc:id="f6e3d655-b943-4687-b076-741c27b562d9">
		<http:listener doc:name="Listener"
			doc:id="31b55406-0fee-4b30-b25e-bd7b0439892e"
			config-ref="HTTP_Listener_config" path="/api/watermark"
			allowedMethods="POST" />
		<set-variable
			value='#[output application/json --- now() &gt;&gt; Mule::p("watermark.timezone")]'
			doc:name="watermarkLastRunDateTimeUpdated"
			doc:id="d1c9d4c6-5a7e-4385-b67a-cc37ad5d2fd2"
			variableName="watermarkLastRunDateTimeUpdated" />
		<flow-ref doc:name="updateWatermarkSubflow"
			doc:id="6c9f20c7-32dd-4878-9c76-a6e6f0004ee4"
			name="updateWatermarkSubflow" />
		<flow-ref doc:name="retrieveWatermarkSubflow"
			doc:id="b5152acc-d039-4fb5-adb0-8fbb9ab99285"
			name="retrieveWatermarkSubflow" target="watermarkLastRunDateTime"
			targetValue="#[output application/json --- payload]" />
		<ee:transform doc:name="Transform Message"
			doc:id="69d8b14f-ebcf-484d-a1fa-13e15b87a10d">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"message": "watermark updated",
	"watermarkLastRunDateTime": vars.watermarkLastRunDateTime
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
