	<sub-flow name="sendBatchSummaryEmailSubflow"
		doc:id="88f32288-fa95-4c65-a1a8-bfde365439fb">
		<ee:transform doc:name="Transform Message" doc:id="fc1ec692-c1af-431e-b400-aeec2593f4d9">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="notification" ><![CDATA[%dw 2.0
output application/java
---
{
	properties: {
		toAddresses: Mule::p("smtp.toEmailAddresses") splitBy ";",
		subject: Mule::p("smtp.subject.batchSummary")
	
	},
	content: {
		transactionId: correlationId,
		batchJobInstanceId: payload.batchJobInstanceId,
		onCompletePhaseException: payload.onCompletePhaseException,
		loadingPhaseException: payload.loadingPhaseException,
		totalRecords: payload.totalRecords,
		elapsedTimeInMillis: payload.elapsedTimeInMillis,
		failedOnCompletePhase: payload.failedOnCompletePhase,
		loadedRecords: payload.loadedRecords,
		failedRecords: payload.failedRecords,
		failedOnInputPhase: payload.failedOnInputPhase,
		successfulRecords: payload.successfulRecords,
		processedRecords: payload.processedRecords,
		failedOnLoadingPhase: payload.failedOnLoadingPhase,
		inputPhaseException: payload.inputPhaseException default "N/A",
		onCompletePhaseException: payload.onCompletePhaseException default "N/A",
		loadingPhaseException: payload.loadingPhaseException default "N/A"
	}
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<parse-template doc:name="Parse Template" doc:id="0a9ba6a8-d7ec-450e-93ae-9b27ac8cd30d" location="email/batchSummaryEmailTemplate" target="emailBody" />
		<flow-ref doc:name="sendEmailSubflow" doc:id="0e3cb5b5-432f-4853-8a26-2564920b585b" name="sendEmailSubflow" />
	</sub-flow>
	<sub-flow name="sendErrHsptlWriteErrorEmailSubflow" doc:id="c7cfe417-db3d-40b3-a17b-8aa0bfcf7b53" >
		<ee:transform doc:name="Transform Message" doc:id="57743219-af25-4828-8817-357b10448ab0">
			<ee:message />
			<ee:variables>
				<ee:set-variable variableName="notification"><![CDATA[%dw 2.0
output application/java
---
{
	properties: {
		toAddresses: Mule::p("smtp.toEmailAddresses") splitBy ";",
		subject: Mule::p("smtp.subject.errHsptlError")
	
	},
	content: {
		transactionId: vars.transactionId,
		errorType: error.errorType.namespace ++ ":" ++ error.errorType.identifier,
		errorMessage: error.description
	}
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<parse-template doc:name="Parse Template" doc:id="54e45530-25bd-4472-9905-ebf5773587ce" location="email/errorHospitalWriteErrorEmailTemplate" target="emailBody" />
		<flow-ref doc:name="sendEmailSubflow" doc:id="fb7e501f-38f5-4064-bb20-b6c414b3bd84" name="sendEmailSubflow"/>
	</sub-flow>
	<sub-flow name="sendEmailSubflow" doc:id="a08c4fb6-2e78-4eb4-b151-342e5a2cacb7" >
		<choice doc:name="Choice" doc:id="89ee9dad-1705-46ac-968e-1c94e4352fbd" >
			<when expression='#[(Mule::p("smtp.enable") as Boolean default false) == true]'>
				<try doc:name="Try" doc:id="fe3b008d-9d98-4e1e-a8ea-0dfa22367260">
			<email:send doc:name="Send" doc:id="70635e43-6646-40fe-8969-04e9bcfc8c38" config-ref="Email_SMTP" subject="#[vars.notification.properties.subject]" toAddresses="#[vars.notification.properties.toAddresses]">
			<email:body contentType="text/html">
				<email:content><![CDATA[#[vars.emailBody]]]></email:content>
			</email:body>
		</email:send>
			<error-handler>
				<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="5f41127e-44f8-4576-a16d-38f84d022674">
					<logger level="WARN" doc:name="Logger" doc:id="59969898-c8b0-4f8f-973b-bf1d472da135" message='#["Email send failed"]' />
				</on-error-continue>
			</error-handler>
		</try>
			</when>
			<otherwise >
				<logger level="WARN" doc:name="Logger" doc:id="fb89d1ef-0474-460c-aa55-f134a5b0b100" message='#["Email disabled"]' />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
