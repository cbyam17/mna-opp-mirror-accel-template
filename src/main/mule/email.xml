	<sub-flow name="sendEmailSubflow" doc:id="a08c4fb6-2e78-4eb4-b151-342e5a2cacb7">
		<logger level="INFO" doc:name="ENTRY" message="ENTRY: sendEmailSubflow" />
		<choice doc:name="Choice" doc:id="89ee9dad-1705-46ac-968e-1c94e4352fbd">
			<when expression='#[(Mule::p("smtp.enable") as Boolean default false) == true]'>
				<try doc:name="Try" doc:id="fe3b008d-9d98-4e1e-a8ea-0dfa22367260">
					<email:send doc:name="Send" doc:id="70635e43-6646-40fe-8969-04e9bcfc8c38" config-ref="Email_SMTP" subject="#[vars.notification.properties.subject]" toAddresses="#[vars.notification.properties.toAddresses]">
						<email:body contentType="text/html">
							<email:content>
								<![CDATA[#[vars.emailBody]]]>
							</email:content>
						</email:body>
					</email:send>
					<error-handler ref="sendEmailErrorHandler" />
				</try>
			</when>
			<otherwise>
				<logger level="WARN" doc:name="Logger" doc:id="fb89d1ef-0474-460c-aa55-f134a5b0b100" message='#["Send email disabled"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="EXIT" message="EXIT: sendEmailSubflow" />
	</sub-flow>
