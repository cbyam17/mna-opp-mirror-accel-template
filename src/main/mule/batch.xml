<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:slack="http://www.mulesoft.org/schema/mule/slack"
	xmlns:vm="http://www.mulesoft.org/schema/mule/vm"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns:scripting="http://www.mulesoft.org/schema/mule/scripting"
	xmlns:batch="http://www.mulesoft.org/schema/mule/batch"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/batch http://www.mulesoft.org/schema/mule/batch/current/mule-batch.xsd
http://www.mulesoft.org/schema/mule/scripting http://www.mulesoft.org/schema/mule/scripting/current/mule-scripting.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/vm http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd
http://www.mulesoft.org/schema/mule/slack http://www.mulesoft.org/schema/mule/slack/current/mule-slack.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">
	<flow name="processBatchOpptyFlow"
		doc:id="f9d4c643-c4c6-4cef-b546-72c118311eb1">
		<flow-ref doc:name="preprocessSubflow" doc:id="5202de1c-b04e-44da-99bb-a8cd00f89c5e" name="preprocessSubflow"/>
		<batch:job jobName="processOpptyBatch"
			doc:id="e850532a-d8c3-4fbe-a642-090fa9afd132">
			<batch:process-records>
				<batch:step name="Batch_Step_Create_Oppty" doc:id="604bc159-50e7-47eb-9f88-42b6d123c5a3" acceptExpression="#[isEmpty(payload.existingOppty)]">
					<batch:aggregator doc:name="Batch Aggregator" doc:id="33a49cc8-241c-42ea-9f79-926e1ce151d8" size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="createOpptySubflow_TGT" doc:id="3db10586-8b [STUDIO] --&gt;fc-4dce-9d37-d860343b1b3d" name="createOpptySubflow_TGT" target="createOpptyResponses" targetValue="#[payload.items.payload default []]"/>
						<foreach doc:name="For Each" doc:id="53052119-4e93-400c-87af-28dcd4852aa2" >
							<scripting:execute engine="Groovy" doc:name="Execute" doc:id="c072a779-9d21-41d0-824f-1625c126a53a" >
								<scripting:code ><![CDATA[vars['record'].payload.upsertOpptyResponse = upsertOpptyResponse]]></scripting:code>
								<scripting:parameters ><![CDATA[#[{
	upsertOpptyResponse: vars.createOpptyResponses[vars.counter-1]
}]]]></scripting:parameters>
							</scripting:execute>
						</foreach>
					</batch:aggregator>
				</batch:step>
				<batch:step name="Batch_Step_Update_Oppty" doc:id="e52d4796-bac1-4f5d-9f55-e1ab20574581" acceptExpression="#[!isEmpty(payload.existingOppty)]">
					<batch:aggregator doc:name="Batch Aggregator" doc:id="8b82c02f-ec84-4435-814f-24d57d26cb3b" size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="updateOpptySubflow_TGT" doc:id="0893fc3e-a171-496c-91b2-f4ab2233124a" name="updateOpptySubflow_TGT" target="updateOpptyResponses" targetValue="#[payload.items.payload default []]" />
						<foreach doc:name="For Each" doc:id="ada676bd-8cf9-40d0-a6e8-b9abfb2b3239">
							<scripting:execute engine="Groovy" doc:name="Execute" doc:id="f0f42b56-d2f2-4122-99e5-7ebb9b57bf33">
								<scripting:code><![CDATA[vars['record'].payload.upsertOpptyResponse = upsertOpptyResponse]]></scripting:code>
								<scripting:parameters><![CDATA[#[{
	upsertOpptyResponse: vars.updateOpptyResponses[vars.counter-1]
}]]]></scripting:parameters>
							</scripting:execute>
						</foreach>
					</batch:aggregator>
				</batch:step>
				<batch:step name="Batch_Step_Create_Oppty_Products" doc:id="99784586-c6cc-4141-85e5-40f70dacb6c0" acceptExpression="#[(payload.upsertOpptyResponse.success == true) and !isEmpty(payload.opptyProductsToCreate)]">
					<flow-ref doc:name="createOpptyProductsSubflow_TGT" doc:id="f401d128-bb3e-4b39-b897-b45e6618e1c6" name="createOpptyProductsSubflow_TGT" target="createOpptyProductResponses" targetValue="#[payload.items.payload default []]" />
					<ee:transform doc:name="Transform Message" doc:id="9e56baa8-3f47-49d2-ab34-696cc6211a1f" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
payload ++ {
	upsertOpptyProductResponses: vars.createOpptyProductResponses default [] map ((item, index) -> item ++ {
		srcId: payload.opptyProductsToCreate[index].Id
	})
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</batch:step>
				<batch:step name="Batch_Step_Update_Oppty_Products" doc:id="5da2a7d5-c9de-4299-b929-2899b0e0762a" acceptExpression="#[(payload.upsertOpptyResponse.success == true) and !isEmpty(payload.opptyProductsToUpdate)]">
					<flow-ref doc:name="updateOpptyProductsSubflow_TGT" doc:id="50ac5569-ae9d-4661-986e-151b77346008" name="updateOpptyProductsSubflow_TGT" target="updateOpptyProductResponses" targetValue="#[payload.items.payload]" />
					<ee:transform doc:name="Transform Message" doc:id="75095d73-21dd-41d8-9d4d-0ed2ff42bf61" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
payload ++ {
	upsertOpptyProductResponses: payload.upsertOpptyProductResponses default [] ++ vars.updateOpptyProductResponses default []
}]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</batch:step>
				<batch:step name="Batch_Step_Delete_Oppty_Products" doc:id="a82353f8-b9ca-4715-9e8a-b360552fa9b7" acceptExpression="#[(payload.upsertOpptyResponse.success == true) and !isEmpty(payload.opptyProductsToDelete)]">
					<flow-ref doc:name="deleteOpptyProductsSubflow_TGT" doc:id="784686c4-21f2-4f23-b1af-c332d9714879" name="deleteOpptyProductsSubflow_TGT" target="deleteOpptyProductResponses"/>
					<logger level="INFO" doc:name="Logger" doc:id="d9cdfacd-2158-4683-ac43-9b72848201f4" />
				</batch:step>
				<batch:step name="Batch_Step_Writeback_Oppty"
					doc:id="df422e29-1828-4fe0-a9bf-062d6f0fbd8b" acceptPolicy="ALL">
					<choice doc:name="Choice" doc:id="84fa5a45-f8bf-40d5-9dd4-f775d6501fbb" >
						<when expression="#[!isEmpty(Batch::getLastException())]">
							<ee:transform doc:name="Transform Message" doc:id="60cade73-6e7e-4963-8e99-5af0ae7e26f6" >
								<ee:message >
									<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
payload ++ {
	sysErrMsg: "A system error occurred during the Opportunity mirroring process; please check integration logs with this transaction Id for more details"
}]]></ee:set-payload>
								</ee:message>
							</ee:transform>
						</when>
					</choice>
					<batch:aggregator doc:name="Batch Aggregator" doc:id="e2ef1527-0deb-4625-9b7e-0be336a0c124" size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="writebackOpptySubflow_SRC" doc:id="dae08b97-4aed-4e91-b0af-b547be519cf7" name="writebackOpptySubflow_SRC" target="writebackOpptyResponses" targetValue="#[payload.items.payload default []]"/>
						<foreach doc:name="For Each" doc:id="e956b2ec-2e0f-430a-bcd5-67f832fe9bc4" >
							<scripting:execute engine="Groovy" doc:name="Execute" doc:id="6c750070-051c-4835-b170-bece09f5a693" >
								<scripting:code ><![CDATA[vars['record'].payload.writebackOpptyResponse = writebackOpptyResponse]]></scripting:code>
								<scripting:parameters ><![CDATA[#[{
	writebackOpptyResponse: vars.writebackOpptyResponses[vars.counter-1]
}]]]></scripting:parameters>
							</scripting:execute>
						</foreach>
					</batch:aggregator>
				</batch:step>
				<batch:step name="Batch_Step_Writeback_Oppty_Products" doc:id="0d47cd71-bccd-4415-b52b-3efcaef7fcb4" >
					<flow-ref doc:name="writebackOpptyProductsSubflow_SRC" doc:id="e0e73069-5ee1-4207-b388-892760d88537" name="writebackOpptyProductsSubflow_SRC" target="writebackOpptyProductResponses" targetValue="#[payload.items.payload default []]"/>
					<ee:transform doc:name="Transform Message" doc:id="2fce2bdc-d2be-4662-9c94-c5a0ce00d22d" >
						<ee:message >
							<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
payload ++ {
	writebackOpptyProductResponses: vars.writebackOpptyProductResponses default []
}]]></ee:set-payload>
						</ee:message>
						<ee:variables />
					</ee:transform>
				</batch:step>
				<batch:step name="Batch_Step_Send_Failed_Record_To_Error_Hospital"
					doc:id="1fa78a7a-c608-4f9d-a7fd-7242c7eb9103" acceptExpression="#[(payload.upsertOpptyResponse.success == false) or (payload.opptyProductsResponse.success contains false) or (payload.writebackOpptyResponse.success == false)]">
					<batch:aggregator doc:name="Batch Aggregator"
						doc:id="9991eb19-ca4e-4525-bc82-284d54679510"
						size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="vmPublishInsertRecordsToErrHsptl" doc:id="f166b9a6-bdc7-4586-b091-66ff04b2acfa" name="vmPublishInsertRecordsToErrHsptl" />
					</batch:aggregator>
					<ee:transform doc:name="Transform Message" doc:id="b26b3bce-80a9-4fed-9c65-b3dce23aa587" >
						<ee:message >
							<ee:set-payload ><![CDATA[import buildSendFailedRecordsToErrHsptlRequest from module::ErrorHospital
output application/json
---
buildFailedRecord(payload)]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</batch:step>
				<batch:step name="Batch_Step_Remove_Successful_Record_From_Error_Hospital"
					doc:id="286946a8-3c81-4ae6-bdc6-2d3f3daee349"
					acceptExpression="#[!isEmpty(payload.existingErrHosptlRecord) and (payload.upsertOpptyResponse.success == true) and (!(payload.opptyProductsResponse.success contains false)) and (payload.writebackOpptyResponse.success == true)]">
					<batch:aggregator doc:name="Batch Aggregator"
						doc:id="517ca65b-1e52-4c22-bb9b-a8872fe879f7"
						size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="vmPublishRemoveRecordsFromErrHsptl" doc:id="8bb88bdc-c450-440e-ad62-47a66fd697c8" name="vmPublishRemoveRecordsFromErrHsptl" />
					</batch:aggregator>
				</batch:step>
				<batch:step
					name="Handle_System_Errors"
					doc:id="be8289a7-36f2-4e1d-a84d-926d5752576e"
					acceptPolicy="ONLY_FAILURES">
					<batch:aggregator doc:name="Batch Aggregator"
						doc:id="6438c5ce-3c90-480e-befc-6e8fc1b7e879"
						size="${batch.aggregatorSize}" preserveMimeTypes="true">
						<flow-ref doc:name="vmPublishInsertRecordsToErrHsptl" doc:id="fe590973-429a-4381-b02a-544f50a77fcf" name="vmPublishInsertRecordsToErrHsptl" />
					</batch:aggregator>
					<ee:transform doc:name="Transform Message" doc:id="9076a6b9-3204-4855-b5b7-0dc587199fb2" >
						<ee:message >
							<ee:set-payload ><![CDATA[import buildSystemErrorRecord from module::ErrorHospital
output application/json
---
buildSystemErrorRecord(payload, Batch::getLastException())]]></ee:set-payload>
						</ee:message>
					</ee:transform>
				</batch:step>
			</batch:process-records>
			<batch:on-complete>
				<flow-ref doc:name="processCompletionSubflow"
					doc:id="073fbf8c-adcb-42fa-b2a3-bb91ac271b5b"
					name="processCompletionSubflow" />
			</batch:on-complete>
		</batch:job>
	</flow>
	<sub-flow name="preprocessSubflow" doc:id="ed19009b-4476-4103-b7b8-70d9eea5ebf2">
		<flow-ref doc:name="getRecordsFromErrHsptlByIdSubflow" doc:id="a02a0611-dd90-4304-b0b7-7c2f50e3dcfe" name="getRecordsFromErrHsptlByIdSubflow" target="existingErrHosptlRecords" targetValue="#[output application/java --- payload]" />
		<flow-ref doc:name="getAcctsByIdSubflow_TGT" doc:id="8a564314-baba-4f0c-a195-7b29537f475f" name="getAcctsByIdSubflow_TGT" target="existingAccts" targetValue="#[output application/java --- payload.payload..records default []]" />
		<flow-ref doc:name="getOpptysByExternalIdSubflow_TGT" doc:id="f45c7f87-d6b0-4029-b9f2-17db2d90fd19" name="getOpptysByExternalIdSubflow_TGT" target="existingOpptys" targetValue="#[output application/java --- payload.payload..records default []]" />
		<flow-ref doc:name="getOpptyProductsByOpptyIdSubflow_TGT" doc:id="f4f35310-1ae1-47c5-ba11-1354443f032f" name="getOpptyProductsByOpptyIdSubflow_TGT" target="existingOpptyProducts" targetValue="#[output application/java --- payload.payload..records default []]" />
		<flow-ref doc:name="getOpptyProductsByOpptyIdSubflow_SRC" doc:id="70a25909-c0a2-463b-9905-d16119aa544d" name="getOpptyProductsByOpptyIdSubflow_SRC" target="opptyProducts" targetValue="#[output application/java --- payload.payload..records default []]" />
		<ee:transform doc:name="Transform Message" doc:id="d9e08992-d681-41b3-8535-bc07011e6a56">
			<ee:message>
				<ee:set-payload><![CDATA[import enrichOpptysWithQueryResults from module::Oppty
output application/java
---
enrichOpptysWithQueryResults(payload, vars.existingAccts, vars.existingOpptys, vars.existingErrHsptlRecords, vars.existingOpptyProducts, vars.opptyProducts)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="removeProprocessVarsSubflow" doc:id="0a5968c9-8721-4a1b-a348-cad4d76dee98" name="removeProprocessVarsSubflow"/>
	</sub-flow>
	<sub-flow name="removeProprocessVarsSubflow" doc:id="ed4bc3c6-4983-4964-bc9a-b7c521c15394">
		<remove-variable doc:name="existingErrHosptlRecords" doc:id="09dfc886-10f2-4060-8ada-089adf114783" variableName="existingErrHosptlRecords" />
		<remove-variable doc:name="existingAccts" doc:id="1c1bdb97-6884-483b-a2ee-4122c1bff146" variableName="existingAccts" />
		<remove-variable doc:name="existingOpptys" doc:id="95ae8c73-1f29-490f-b1d0-4105462626f2" variableName="existingOpptys" />
		<remove-variable doc:name="existingOpptyProducts" doc:id="fac3d4f7-1541-459a-9098-6f1169e617ca" variableName="existingOpptyProducts" />
		<remove-variable doc:name="opptyProducts" doc:id="364a61a4-cd18-45fb-92c7-afbf6169fe97" variableName="opptyProducts" />
	</sub-flow>
	<sub-flow name="processCompletionSubflow"
		doc:id="f482850f-b8a9-46a8-b1eb-d2d432cb8c01">
		<logger level="INFO" doc:name="INFO"
			doc:id="15f98af9-fff1-4f2e-8daf-6321fe63b5ad"
			message='#["Batch job summary: " ++ write(payload,"application/json")]' />
		<choice doc:name="Choice"
			doc:id="7f8a309e-366c-415e-a366-59114226cfa2">
			<when
				expression="#[vars.isRetryJob == true]">
				<flow-ref doc:name="clearOsBatchStatusRetrySubflow"
					doc:id="34d5ccab-25aa-415b-b229-b1f648c1e0d1"
					name="clearOsBatchStatusRetrySubflow" />
			</when>
			<otherwise>
				<flow-ref doc:name="clearOsBatchStatusSubflow"
					doc:id="36c56c53-9fbd-4b9c-8ee8-3c13b0354419"
					name="clearOsBatchStatusSubflow" />
				<flow-ref doc:name="processCompletionSendEmailSubflow"
					doc:id="dc8788b7-665c-4577-8dc6-216f7c842c95"
					name="processCompletionSendEmailSubflow" />
				<flow-ref
					doc:name="processCompletionUpdateWatermarkSubflow"
					doc:id="80602d16-dc27-49b8-bb4c-379c6b29f6a7"
					name="processCompletionUpdateWatermarkSubflow" />
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="processCompletionSendEmailSubflow"
		doc:id="2b7bb81c-4f11-4881-8569-8c69a384bce4">
		<logger level="INFO" doc:name="INFO"
			doc:id="cd1ca965-01c1-40f6-83dd-7ab2d357340a"
			message='#["processCompletionSendEmailSubflow entry"]' />
		<choice doc:name="Choice"
			doc:id="9b5bafa1-216c-4f44-a727-d5950fa6d56b">
			<when expression="#[payload.failedRecords &gt; 0]">
				<flow-ref doc:name="sendSummaryEmailSubflow"
					doc:id="639012a1-d200-4e83-9c6c-b87a5c91790f"
					name="sendSummaryEmailSubflow" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="INFO"
					doc:id="bd6772ed-7300-4477-9766-346204aed46c"
					message='#["No need to send failure email as failedRecords count is zero"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="c7aadce4-883c-480f-b80e-64bc49232660"
			message='#["processCompletionSendEmailSubflow exit"]' />
	</sub-flow>
	<sub-flow name="processCompletionUpdateWatermarkSubflow"
		doc:id="3cb1fdf0-84b6-4ee2-8d48-464353647a34">
		<logger level="INFO" doc:name="INFO"
			doc:id="192f0364-b237-48f0-803d-d6624b7aa380"
			message='#["processCompletionUpdateWatermarkSubflow entry"]' />
		<flow-ref doc:name="retrieveOsCurrentRunDateTimeSubflow"
			doc:id="8e372012-9eda-4d64-898f-c78a1caeb1be"
			name="retrieveOsCurrentRunDateTimeSubflow"
			target="watermarkLastRunDateTimeUpdated"
			targetValue="#[output application/json --- payload]" />
		<choice doc:name="Choice"
			doc:id="2d0ff0e8-0599-4e09-83d0-45e78ed3e121">
			<when
				expression="#[!isEmpty(vars.watermarkLastRunDateTimeUpdated)]">
				<flow-ref doc:name="updateWatermarkSubflow"
					doc:id="9beb9821-b6b7-464e-81b9-2f0023b23eaf"
					name="updateWatermarkSubflow" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger"
					doc:id="08b15500-e2ad-498a-a2c7-d8f2e9cf1e34"
					message='#["The watermark value is not available to update back in the watermark service"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="94e9090c-6b91-4076-886a-d0d680395f4d"
			message='#["processCompletionUpdateWatermarkSubflow exit"]' />
	</sub-flow>
</mule>
