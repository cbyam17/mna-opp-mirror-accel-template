				<flow-ref doc:name="updateWatermarkSubflow" doc:id="20f56cfd-2787-4d9a-b313-9ba936b50734" name="updateWatermarkSubflow" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="INFO" doc:id="98f5cebd-4332-4eeb-9f8a-350a9d3ed2af" message='#["The watermark value is not available to update back in the watermark service"]' />
			</otherwise>
		</choice>
	</sub-flow>
</mule>
