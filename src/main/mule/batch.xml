			doc:id="2d0ff0e8-0599-4e09-83d0-45e78ed3e121">
			<when
				expression="#[!isEmpty(vars.watermarkLastRunDateTimeUpdated)]">
				<flow-ref doc:name="updateWatermarkSubflow"
					doc:id="9beb9821-b6b7-464e-81b9-2f0023b23eaf"
					name="updateWatermarkSubflow" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger"
					doc:id="08b15500-e2ad-498a-a2c7-d8f2e9cf1e34"
					message='#["The watermark value is not available to update back in the watermark service"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="94e9090c-6b91-4076-886a-d0d680395f4d"
			message='#["processCompletionUpdateWatermarkSubflow exit"]' />
	</sub-flow>
</mule>
