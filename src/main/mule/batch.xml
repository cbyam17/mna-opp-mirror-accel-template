		<logger level="INFO" doc:name="INFO"
			doc:id="15f98af9-fff1-4f2e-8daf-6321fe63b5ad"
			message='#["Batch job summary: " ++ write(payload,"application/json")]' />
		<choice doc:name="Choice"
			doc:id="7f8a309e-366c-415e-a366-59114226cfa2">
			<when
				expression="#[!isEmpty(vars.isRetryJob) and vars.isRetryJob]">
				<flow-ref doc:name="clearOsBatchStatusRetrySubflow"
					doc:id="34d5ccab-25aa-415b-b229-b1f648c1e0d1"
					name="clearOsBatchStatusRetrySubflow" />
