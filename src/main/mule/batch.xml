					message='#["No need to send failure email and update watermark for retry job or admin flow"]' />
			</when>
			<otherwise>
				<flow-ref doc:name="clearOsBatchStatusSubflow"
					doc:id="36c56c53-9fbd-4b9c-8ee8-3c13b0354419"
					name="clearOsBatchStatusSubflow" />
				<flow-ref doc:name="processCompletionSendEmailSubflow"
					doc:id="dc8788b7-665c-4577-8dc6-216f7c842c95"
					name="processCompletionSendEmailSubflow" />
				<flow-ref
					doc:name="processCompletionUpdateWatermarkSubflow"
					doc:id="80602d16-dc27-49b8-bb4c-379c6b29f6a7"
					name="processCompletionUpdateWatermarkSubflow" />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="4db2af0f-3ac2-46c7-a283-a03c091e9eda"
			message='#["processCompletionSubflow exit"]' />
	</sub-flow>
	<sub-flow name="processCompletionSendEmailSubflow"
		doc:id="2b7bb81c-4f11-4881-8569-8c69a384bce4">
		<logger level="INFO" doc:name="INFO"
			doc:id="cd1ca965-01c1-40f6-83dd-7ab2d357340a"
			message='#["processCompletionSendEmailSubflow entry"]' />
		<choice doc:name="Choice"
			doc:id="9b5bafa1-216c-4f44-a727-d5950fa6d56b">
			<when expression="#[payload.failedRecords &gt; 0]">
				<flow-ref doc:name="sendSummaryEmailSubflow"
					doc:id="639012a1-d200-4e83-9c6c-b87a5c91790f"
					name="sendSummaryEmailSubflow" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="INFO"
					doc:id="bd6772ed-7300-4477-9766-346204aed46c"
					message='#["No need to send failure email as failedRecords count is zero"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="c7aadce4-883c-480f-b80e-64bc49232660"
			message='#["processCompletionSendEmailSubflow exit"]' />
	</sub-flow>
	<sub-flow name="processCompletionUpdateWatermarkSubflow"
		doc:id="3cb1fdf0-84b6-4ee2-8d48-464353647a34">
		<logger level="INFO" doc:name="INFO"
			doc:id="192f0364-b237-48f0-803d-d6624b7aa380"
			message='#["processCompletionUpdateWatermarkSubflow entry"]' />
		<flow-ref doc:name="retrieveOsCurrentRunDateTimeSubflow"
			doc:id="8e372012-9eda-4d64-898f-c78a1caeb1be"
