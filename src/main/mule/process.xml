	<sub-flow name="processAdminSubflow" doc:id="af3691a9-9c5d-4ed6-8c36-5311c8ab3b7d" >
		<logger level="INFO" doc:name="INFO" doc:id="a19bc96f-3bcf-4ea2-850c-50ef9a1b0fec" message='#["processAdminSubflow entry"]' />
		<ee:transform doc:name="Transform Message" doc:id="407298e8-41e0-4c70-8aff-e0cd9da6f499">
			<ee:message>
				<ee:set-payload><![CDATA[import buildQueryOpptyFromSourceById from module::Oppty
output application/json
---
buildQueryOpptyFromSourceById(payload.externalIds)]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="retrieveOpptyFromSourceByIdSubflow" doc:id="1f4aec94-f849-4fd7-af87-6c5cbdeb5b2b" name="retrieveOpptyFromSourceByIdSubflow" target="sourceOpptyRecordsById" targetValue="#[output application/json --- payload.payload..records default []]" />
		<choice doc:name="Choice" doc:id="7cb59f68-098c-4e63-81ea-db3cbe73b548">
			<when expression="#[sizeOf(payload.externalIds default []) &gt; sizeOf(vars.sourceOpptyRecordsById default [])]">
				<ee:transform doc:name="Transform Message" doc:id="82aee42c-fb4d-4286-80b6-1a6f7ce38829">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
	Id: ((payload.externalIds default []) -- (vars.sourceOpptyRecordsById default []))
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="INFO" doc:id="aecd4380-e4a9-42f3-bc7a-e171b19dc4dd" message='#[write(sizeOf(payload),"application/json") ++ " records will be deleted from error hospital"]' />
				<flow-ref doc:name="deleteRecordsFromErrorHospitalFlow" doc:id="979a7e10-bc4d-49f0-9f63-838c8275d18d" name="deleteRecordsFromErrorHospitalFlow" />
			</when>
		</choice>
		<set-payload value="#[output application/java --- vars.sourceOpptyRecordsById]" doc:name="Set Payload" doc:id="24c94a1f-9178-4606-87bd-976804726442" />
		<remove-variable doc:name="sourceOpptyRecordsById" doc:id="b9dc57f0-3843-4c46-89d5-d1f8be9eba0c" variableName="sourceOpptyRecordsById"/>
		<choice doc:name="Choice" doc:id="36a7c548-46b4-4c59-b252-70df99c0f21f" >
			<when expression="#[!isEmpty(payload)]" >
				<set-variable value="#[true]" doc:name="isRetryJob" doc:id="b9c18a82-960b-4f2d-89bf-46bc6c05f786" variableName="isRetryJob" />
				<logger level="INFO" doc:name="INFO" doc:id="9ebc11b0-a8f7-455e-8cda-60c602acb830" message='#["Starting batch process from admin subflow"]' />
				<flow-ref doc:name="processBatchOpptyFlow" doc:id="d9c3f7e4-0629-42cd-b4b4-8790f2664f9e" name="processBatchOpptyFlow" />
				<logger level="INFO" doc:name="INFO" doc:id="299c7577-be86-45a5-9921-268aeb639149" message='#["Initiated batch process from admin subflow"]' />
			</when>
			<otherwise >
				<logger level="WARN" doc:name="WARN" doc:id="05ea5550-c179-4080-99b6-e89426cee1d0" message='#["No opportunity records available to process"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO" doc:id="e38d797f-d276-4576-9be7-c9a2422247db" message='#["processAdminSubflow exit"]' />
	</sub-flow>
</mule>
