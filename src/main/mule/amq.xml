http://www.mulesoft.org/schema/mule/ee/tracking http://www.mulesoft.org/schema/mule/ee/tracking/current/mule-tracking-ee.xsd">
	<sub-flow name="amqPublishInsertRecordsToErrorHospital" doc:id="1f1bed41-ea02-476c-9837-ab1851dec770">
		<anypoint-mq:publish doc:name="Publish" doc:id="a63b898c-4253-4523-a7d0-c15079e653b6" destination="${amq.errHsptlInsertRecordsQueue}" config-ref="Anypoint_MQ_Config">
			<anypoint-mq:body ><![CDATA[#[output application/json --- payload]]]></anypoint-mq:body>
			<anypoint-mq:properties ><![CDATA[#[output application/java --- { transactionId: correlationId}]]]></anypoint-mq:properties>
		</anypoint-mq:publish>
	</sub-flow>
	<sub-flow name="amqPublishRemoveRecordsFromErrorHospital"
		doc:id="d19291aa-a3f6-495d-bf3a-1b35957621a2">
		<anypoint-mq:publish doc:name="Publish" doc:id="5a6b6b60-1f7f-4bc0-89cd-ba7655a80adc" config-ref="Anypoint_MQ_Config" destination="${amq.errHsptlRemoveRecordsQueue}">
			<anypoint-mq:body ><![CDATA[#[output application/json --- payload]]]></anypoint-mq:body>
			<anypoint-mq:properties ><![CDATA[#[output application/java --- { transactionId: correlationId}]]]></anypoint-mq:properties>
		</anypoint-mq:publish>
	</sub-flow>
	<flow name="vmListenerSendRecordsToErrorHospital"
		doc:id="4803ef34-5de8-43da-b95c-d73eb2dc3886">
