		<set-variable value="#[output application/java --- attributes.properties.transactionId]" doc:name="transactionId" doc:id="7e672f64-9c49-427c-bfda-9b9ef0d11329" variableName="transactionId"/>
		<flow-ref doc:name="sendRecordsToErrHsptlSubflow" doc:id="5ea01d9e-6ce3-4daa-8c74-0331764c121f" name="sendRecordsToErrHsptlSubflow" />
		<error-handler ref="errorHospitalWriteErrorHandler" />
	</flow>
	<flow name="vmListenerhRemoveRecordsFromErrorHospital"
		doc:id="35a4df5f-958c-4dd1-ad44-035535ed97ca">
		<anypoint-mq:subscriber doc:name="Subscriber" doc:id="8ea09e03-93a1-4a31-94ed-108606ef91e9" config-ref="Anypoint_MQ_Config" destination="${amq.errHsptlRemoveRecordsQueue}"/>
		<set-variable value="#[output application/java --- attributes.properties.transactionId]" doc:name="transactionId" doc:id="3a692efa-9135-40b4-b5bd-3ea0c9db097d" variableName="transactionId" />
		<flow-ref doc:name="removeRecordsFromErrHsptlSubflow" doc:id="55c94c73-7ff9-4438-a123-cd81d7bc52f0" name="removeRecordsFromErrHsptlSubflow" />
