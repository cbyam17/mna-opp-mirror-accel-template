<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:tracing="http://www.mulesoft.org/schema/mule/tracing"
	xmlns:tracking="http://www.mulesoft.org/schema/mule/ee/tracking"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/tracking http://www.mulesoft.org/schema/mule/ee/tracking/current/mule-tracking-ee.xsd
http://www.mulesoft.org/schema/mule/tracing http://www.mulesoft.org/schema/mule/tracing/current/mule-tracing.xsd">
	<flow name="schedulerMainFlow"
		doc:id="88f0347d-0c87-4165-ac1c-3ae661fdcb4d">
		<scheduler doc:name="Main Scheduler"
			doc:id="2b7e4435-4f23-48ce-95c3-f28cb8e7a31a">
			<scheduling-strategy>
				<cron expression="${scheduler.main.cronExpression}"
					timeZone="${scheduler.main.timezone}" />
			</scheduling-strategy>
		</scheduler>
		<logger level="INFO" doc:name="INFO"
			doc:id="15351bb9-1c5f-4240-96c0-122c09936e66"
			message='#["schedulerMainFlow entry"]' />
		<flow-ref doc:name="retrieveOsBatchStatusSubflow"
			doc:id="6a709ed5-1140-4faf-bb41-5f556ed13a67"
			name="retrieveOsBatchStatusSubflow" />
		<choice doc:name="Choice"
			doc:id="56f92143-0d90-4042-8d90-7859b78ab716">
			<when expression="#[isEmpty(payload)]">
				<flow-ref doc:name="pingSubflow"
					doc:id="32ec2cbd-493f-4676-bc44-38888c3fac57" name="pingSubflow"
					targetValue="#[output applicatin/json --- payload]" />
				<logger level="DEBUG" doc:name="DEBUG"
					doc:id="527738a3-ba85-4553-be2d-095630ccfd74"
					message='#["Connectivity status response: " ++ write(payload,"application/json")]' />
				<choice doc:name="Choice"
					doc:id="ab612b9c-98f1-4a55-97c4-cf3b90946384">
					<when expression='#[payload.status == "UP"]'>
						<flow-ref doc:name="processMainSubflow"
							doc:id="9f9d7288-cb6e-4e91-b9ac-bfbfb6feb925"
							name="processMainSubflow" />
					</when>
					<otherwise>
						<logger level="INFO" doc:name="INFO"
							doc:id="954c1c23-5582-4a89-9f28-fc573e44b3f5"
							message='#["At least one connection is unsuccessful; cannot proceed"]' />
						<flow-ref doc:name="sendConnectionFailureEmailSubflow"
							doc:id="7d2dcca2-f91a-4a28-a108-c7032a1a59a8"
							name="sendConnectionFailureEmailSubflow" />
					</otherwise>
				</choice>
			</when>
			<otherwise>
				<logger level="WARN" doc:name="WARN"
					doc:id="a425c1f7-ee23-44c1-8b65-1151643f547a"
					message='#["Previous batch run is in progress; skipping this run"]' />
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="INFO"
			doc:id="88174f8d-5914-4894-8f02-0a99b5d6c169"
			message='#["schedulerMainFlow exit"]' />
	</flow>
