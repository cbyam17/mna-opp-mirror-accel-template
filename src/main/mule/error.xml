<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:os="http://www.mulesoft.org/schema/mule/os"
	xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/anypoint-mq http://www.mulesoft.org/schema/mule/anypoint-mq/current/mule-anypoint-mq.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<error-handler name="apiErrorHandler">

		<!-- 400 Bad Request -->
		<on-error-propagate type="APIKIT:BAD_REQUEST">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Bad request"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

		<!-- 404 Not Found -->
		<on-error-propagate type="APIKIT:NOT_FOUND">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Resource not found"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[404]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

		<!-- 405 Method Not Allowed -->
		<on-error-propagate
			type="APIKIT:METHOD_NOT_ALLOWED">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Method not allowed"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[405]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

		<!-- 406 Not Acceptable -->
		<on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Not acceptable"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[406]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

		<!-- 415 Unsupported Media Type -->
		<on-error-propagate
			type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Unsupported media type"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[415]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

		<!-- 501 Not Implemented -->
		<on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
			<ee:transform>
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	transactionId: correlationId,
	message: "Not implemented"
}]]></ee:set-payload>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="httpStatus"><![CDATA[501]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		</on-error-propagate>

	</error-handler>
	<error-handler name="healthCheckErrorHandler"
		doc:id="baa5e588-002a-49ee-8a98-3edd103ecfa8">
		<on-error-continue enableNotifications="true"
			logException="true" doc:name="On Error Continue"
			doc:id="790d98dd-1436-495a-bf1c-fb459bf01a6d" type="ANY">
			<logger level="ERROR" doc:name="Logger" doc:id="7904728e-b689-4796-b293-88f7b7cd64c2" message='#["Health check failure"]' />
			<ee:transform doc:name="Transform Message"
				doc:id="2b81a4b5-aaa9-466f-bfb7-37bfa12ea2c5">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
import buildHealthCheckEndpointResponse from module::CommonUtils
---
buildHealthCheckEndpointResponse(vars.systemName, error)]]></ee:set-payload>
				</ee:message>
			</ee:transform>
		</on-error-continue>
	</error-handler>
	<error-handler name="batchPreprocessingErrorHandler"
		doc:id="9a9101f9-555c-4bd0-be38-d3d815193de8">
		<on-error-propagate enableNotifications="true"
			logException="true" doc:name="On Error Propagate"
			doc:id="895a9366-272d-4a8c-98ca-4a83a5a3aaf8" type="ANY">
			<logger level="ERROR" doc:name="Logger" doc:id="2e0ba7f9-39c0-4310-ad95-54d2ce350e8b" message='#["Batch pre-processing failure"]' />
			<choice doc:name="Choice" doc:id="0981fe35-66a9-4bc6-8946-f06fee7bbad2" >
				<when expression="#[vars.isRetryJob default false]">
					<flow-ref doc:name="clearOsBatchStatusRetrySubflow" doc:id="3c1d6bc6-6e4a-48d9-94ec-df4c0edbdda4" name="clearOsBatchStatusRetrySubflow" />
				</when>
				<otherwise >
					<flow-ref doc:name="clearOsBatchStatusSubflow" doc:id="cda78ee1-7f93-45b0-944f-dc00826fb878" name="clearOsBatchStatusSubflow" />
				</otherwise>
			</choice>
			<flow-ref doc:name="sendSchedulerFailureEmailSubflow"
				doc:id="6957d07f-2389-46c1-a3de-244a39e43418"
				name="sendbatchPreprocessingErrorEmailSubflow" />
		</on-error-propagate>
	</error-handler>
	<error-handler name="batchPostprocessingErrorHandler"
		doc:id="46800d61-dc69-4403-9dcf-3091170d3edd">
		<on-error-propagate enableNotifications="true"
			logException="true" doc:name="On Error Propagate"
			doc:id="a58a1d69-b960-4ae7-8aad-9bae8537395d" type="ANY">
			<logger level="ERROR" doc:name="Logger" doc:id="02add75b-f653-433d-8109-2771c3cd29e4" message='#["Batch post-processing failure"]' />
			<choice doc:name="Choice" doc:id="6d31f490-0a90-4b5f-b268-01356a544807">
				<when expression="#[vars.isRetryJob default false]">
					<flow-ref doc:name="clearOsBatchStatusRetrySubflow" doc:id="4ead6a05-5a67-4ecf-8677-9591003a6aa3" name="clearOsBatchStatusRetrySubflow" />
				</when>
				<otherwise>
					<flow-ref doc:name="clearOsBatchStatusSubflow" doc:id="ed9c9098-5a8f-47bc-b176-1ff14ad058b5" name="clearOsBatchStatusSubflow" />
				</otherwise>
			</choice>
			<flow-ref
				doc:name="sendbatchPostprocessingErrorEmailSubflow"
				doc:id="2a9d9528-e4d6-46e1-bad3-2f0347370955"
				name="sendBatchPostprocessingErrorEmailSubflow" />
		</on-error-propagate>
	</error-handler>
	<error-handler name="errorHospitalWriteErrorHandler" doc:id="e9903598-d52e-45ff-aed5-9048b760d6bc">
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="5db42ec7-6d74-4b61-809d-ba1378de6bc0">
			<logger level="ERROR" doc:name="Logger" doc:id="53225cfe-e748-46e9-b21f-f80da3c6a1c1" message='#["Error hospital write failure"]' />
			<choice doc:name="Choice" doc:id="3e74a92f-2281-40c7-8185-ae1fc2921799" >
				<when expression="#[vars.isRetryJob default false]">
					<flow-ref doc:name="osStoreFailureBufferSubflow" doc:id="c6266479-3731-4730-90f3-057de09d39bc" name="storeOsFailureBufferSubflow" />
				</when>
				<otherwise >
					<logger level="WARN" doc:name="Logger" doc:id="45ba74f4-d787-46ac-8140-5ee593e7ca87" message='#["No need to capture error hospital write failure for retry job"]' />
				</otherwise>
			</choice>
		</on-error-continue>
	</error-handler>
	<error-handler name="sendEmailErrorHandler" doc:id="0004a733-dd69-443f-91d3-01f989efdc80" >
		<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="840bedad-64f3-490c-8f7e-77b2225caa70" >
			<logger level="ERROR" doc:name="Logger" doc:id="b967ca57-c9bd-4b4b-964d-d9283f4b6bbd" message='#["Send email failure"]' />
		</on-error-continue>
	</error-handler>
</mule>
