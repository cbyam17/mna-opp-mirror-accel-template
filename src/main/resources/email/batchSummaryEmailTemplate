<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Batch Completion Error Summary</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: #f7f7f7;
      margin: 0;
      padding: 0;
      color: #333;
    }
    .container {
      background: #ffffff;
      max-width: 600px;
      margin: 30px auto;
      padding: 25px 30px;
      border-radius: 8px;
      border: 1px solid #dedede;
    }
    h2 {
      color: #c62828;
      margin-top: 0;
    }
    .section {
      margin-bottom: 20px;
    }
    .label {
      font-weight: bold;
      color: #222;
    }
    .footer {
      margin-top: 30px;
      font-size: 12px;
      color: #777;
      text-align: center;
    }
    .highlight {
      background-color: #fbe9e7;
      padding: 10px;
      border-left: 4px solid #d84315;
      border-radius: 4px;
      font-family: Consolas, Courier, monospace;
      white-space: pre-wrap;
    }
  </style>
</head>
<body>

<div class="container">
  <h2>Batch Completion Error Summary</h2>

  <p>
    The batch job has completed with errors. Review the details below to determine whether any
    remediation is needed.
  </p>

  <!-- Properties -->
  
  <div class="section">
    <p><span class="label">Transaction ID:</span><br>
      #[output application/java --- vars.notification.content.transactionId]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Batch Job Instance ID:</span><br>
      #[output application/java --- vars.notification.content.batchJobInstanceId]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Total Records:</span><br>
      #[output application/java --- vars.notification.content.totalRecords]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Loaded Records:</span><br>
      #[output application/java --- vars.notification.content.loadedRecords]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Processed Records:</span><br>
      #[output application/java --- vars.notification.content.processedRecords]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Successful Records:</span><br>
      #[output application/java --- vars.notification.content.successfulRecords]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Failed Records:</span></p><br>
      #[output application/java --- vars.notification.content.failedRecords]
  </div>
  
  <div class="section">
    <p><span class="label">Elapsed Time (ms):</span><br>
      #[output application/java --- vars.notification.content.elapsedTimeInMillis]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Failed on Input Phase:</span><br>
      #[output application/java --- vars.notification.content.failedOnInputPhase]
    </p>
  </div>
  
  <div class="section">
    <p><span class="label">Input Phase Exception:</span></p>
    <div class="highlight">
      #[output application/java --- vars.notification.content.inputPhaseException]
    </div>
  </div>

  <div class="section">
    <p><span class="label">Failed on Loading Phase:</span><br>
      #[output application/java --- vars.notification.content.failedOnLoadingPhase]
    </p>
  </div>

  <div class="section">
    <p><span class="label">Loading Phase Exception:</span></p>
    <div class="highlight">
      #[output application/java --- vars.notification.content.loadingPhaseException]
    </div>
  </div>

  <div class="section">
    <p><span class="label">Failed On Complete Phase:</span><br>
      #[output application/java --- vars.notification.content.failedOnCompletePhase]
    </p>
  </div>

  <div class="section">
    <p><span class="label">On Complete Phase Exception:</span></p>
    <div class="highlight">
      #[output application/java --- vars.notification.content.onCompletePhaseException]
    </div>
  </div>

  
  

  <div class="section">
